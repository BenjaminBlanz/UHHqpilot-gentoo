[Unit]
Description=Q Pilot client service (Uni Hamburg follow-me printing)
After=network-online.target
Wants=network-online.target
Before=cups.service

[Service]
Type=simple
ExecStart=/usr/libexec/qpilot-client/qpilot-client-service
User=qpilot
Group=qpilot
# The Q Pilot server sets the LPD port the service listens on to 515.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
SuccessExitStatus=143
Restart=on-failure

[Install]
WantedBy=multi-user.target
