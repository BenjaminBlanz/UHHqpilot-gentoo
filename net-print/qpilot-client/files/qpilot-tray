#!/usr/bin/env python3
"""Tray icon for the Q Pilot GUI, driven by QPilotTrayBridge over stdin/stdout.

Prints "available" if a system tray (StatusNotifierItem host) exists, then
shows the tray state it reads as JSON lines, e.g.
{"tooltip": "Q Pilot Client GUI", "icon": "<base64 PNG>", "menu": [...]},
and reports clicks as "activate 2/0\tAnmeldedaten ändern" or "open".
"""

import base64
import json
import os
import sys

from PyQt6.QtCore import QSocketNotifier
from PyQt6.QtGui import QIcon, QPixmap
from PyQt6.QtWidgets import QApplication, QMenu, QSystemTrayIcon


def send(line):
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


class Tray:
    def __init__(self, app):
        self.app = app
        self.tray = QSystemTrayIcon()
        self.menu = QMenu()
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self.on_activated)
        self.buffer = b""
        self.notifier = QSocketNotifier(sys.stdin.fileno(), QSocketNotifier.Type.Read)
        self.notifier.activated.connect(self.on_input)

    def on_input(self):
        data = os.read(sys.stdin.fileno(), 1 << 16)
        if not data:
            self.app.quit()
            return
        self.buffer += data
        while b"\n" in self.buffer:
            line, self.buffer = self.buffer.split(b"\n", 1)
            self.apply(json.loads(line))

    def apply(self, state):
        if "icon" in state:
            pixmap = QPixmap()
            pixmap.loadFromData(base64.b64decode(state["icon"]), "PNG")
            self.tray.setIcon(QIcon(pixmap))
        self.tray.setToolTip(state.get("tooltip", ""))
        self.menu.clear()
        self.fill(self.menu, state.get("menu", []))
        if not self.tray.isVisible():
            self.tray.show()

    def fill(self, menu, items):
        for item in items:
            kind = item["kind"]
            if kind == "separator":
                menu.addSeparator()
            elif kind == "submenu":
                sub = menu.addMenu(item["label"])
                sub.setEnabled(item["enabled"])
                self.fill(sub, item["items"])
            else:
                action = menu.addAction(item["label"])
                action.setEnabled(item["enabled"])
                if kind == "check":
                    action.setCheckable(True)
                    action.setChecked(item["checked"])
                command = f"activate {item['path']}\t{item['label']}"
                action.triggered.connect(lambda _checked=False, c=command: send(c))

    def on_activated(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            send("open")


def main():
    sys.stdout.reconfigure(encoding="utf-8")
    app = QApplication(sys.argv[:1])
    app.setApplicationName("qpilot-client")
    app.setDesktopFileName("qpilot-client-gui")
    app.setQuitOnLastWindowClosed(False)
    if not QSystemTrayIcon.isSystemTrayAvailable():
        send("unavailable")
        return 0
    send("available")
    tray = Tray(app)  # noqa: F841 (kept alive for the event loop)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
